# Copy to .env.local (never commit it) and fill in. Used only by `npm run dev`: in the cluster
# the same values come from the Helm values (frontends.public.env) through /config.js.
# Every VITE_ value ends up in the browser bundle, so never put a secret here.
VITE_GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# Cloudflare Turnstile site key. This is Cloudflare's test key, which always passes; fine locally.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA