# Copy to .env (never commit .env).
# Sign-in needs no settings here. The dev server (npm run dev) shows an email box, which works only with a
# backend started with ENV=dev and DEV_AUTH_EMAIL. A production build relies on Cloudflare Access in front of the console.

# Where the dev server forwards /api/admin. Default: http://localhost:8001
# (host port 8001 = admin-api; 8000 is chat-backend, used by public-frontend).
ADMIN_API_URL=http://localhost:8001