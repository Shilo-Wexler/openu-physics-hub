# Copy to .env (never commit .env).
# OAuth Web client ID from Google Cloud Console. Not a secret (the browser sees it), but kept out of git.
# Leave empty to use the dev sign-in (works only with a backend started with DEV_AUTH_EMAIL).
VITE_GOOGLE_CLIENT_ID=

# Where the dev server forwards /api/admin. Default: http://localhost:8001
# (host port 8001 = admin-api; 8000 is chat-backend, used by public-frontend).
ADMIN_API_URL=http://localhost:8001
