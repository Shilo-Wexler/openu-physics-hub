# Copy to .env (never commit .env) and fill in.

# dev allows the dev sign-in and other developer conveniences. Unset means prod.
ENV=dev
DATABASE_URL=postgresql://admin_app:CHANGE_ME@localhost:5432/admin_db
# Origin of the admin console, for CORS. Comma-separated if more than one.
ALLOWED_ORIGINS=http://localhost:5174

# Cloudflare Access, required in prod: the team domain and the application's AUD tag.
# CF_ACCESS_TEAM_DOMAIN=CHANGE_ME.cloudflareaccess.com
# CF_ACCESS_AUD=CHANGE_ME
# Bypasses Cloudflare Access sign-in. Refused unless ENV=dev.
# DEV_AUTH_EMAIL=

# The chat backend's /internal API, for moderation and stats. MOD_API_TOKEN is the same
# value the chat backend has (at least 32 characters).
CHAT_API_URL=http://localhost:8000
MOD_API_TOKEN=CHANGE_ME

# Cloudflare Turnstile secret, required in prod. This is Cloudflare's test secret,
# which always passes; fine locally.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA