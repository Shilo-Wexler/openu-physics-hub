# Copy to .env (never commit .env) and fill in.
# A secret can also come from a file: set NAME_FILE to its path instead of NAME.

# dev turns on the API docs. Unset means prod.
ENV=dev
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# At least 32 characters. The admin backend sends the same value.
MOD_API_TOKEN=CHANGE_ME

# Optional; the defaults are shown.
# DB_POOL_MAX=10
# SESSION_DAYS=400
# READY_TIMEOUT=2